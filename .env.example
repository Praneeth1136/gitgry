# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gitgry?retryWrites=true&w=majority

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Security & Encryption (AES-256-GCM 32-byte hex key, 64 hex characters)
ENCRYPTION_KEY=your_64_character_hex_encryption_key
SESSION_SECRET=your_session_secret_string

# GitHub Actions Cloud Dispatcher (Optional: used for workflow_dispatch)
GITHUB_AUTOMATION_REPO=your_username/gitgry
GITHUB_AUTOMATION_WORKFLOW=repository-maintenance.yml
GITHUB_DISPATCH_TOKEN=your_github_personal_access_token_or_app_token

